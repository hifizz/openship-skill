{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hifizz/openship-skill/schemas/secret-exposure-evidence.schema.json",
  "title": "Openship Secret Exposure Evidence",
  "description": "Evidence about output behavior. Never include a secret or canary value in this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sinks"],
  "properties": {
    "schemaVersion": {"const": 1},
    "instanceVersion": {"type": "string"},
    "cliVersion": {"type": "string"},
    "checkedAt": {"type": "string"},
    "sinks": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "enum": [
              "unknown",
              "plaintext",
              "masked",
              "metadata-only",
              "sanitized-only",
              "write-only",
              "not-applicable"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "method"],
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "plaintext",
                  "masked",
                  "metadata-only",
                  "sanitized-only",
                  "write-only",
                  "not-applicable"
                ]
              },
              "method": {"enum": ["live-schema", "official-source", "disposable-canary", "operator-assertion"]},
              "verifiedAt": {"type": "string"},
              "scope": {"type": "string"},
              "note": {"type": "string"}
            }
          }
        ]
      }
    }
  }
}
