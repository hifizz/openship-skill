{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hifizz/openship-skill/schemas/secret-exposure-plan.schema.json",
  "title": "Openship Secret Exposure Plan",
  "description": "A metadata-only, fail-closed assessment produced before an Openship build or operation that may touch secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operation",
    "repository",
    "touchesSensitiveData",
    "sources",
    "findings",
    "sinks",
    "evidence",
    "decision",
    "blockingReasons",
    "requiredActions"
  ],
  "properties": {
    "schemaVersion": {"const": "0.2"},
    "generatedAt": {"type": "string"},
    "operation": {
      "enum": [
        "build",
        "deploy",
        "logs",
        "env-read",
        "env-write",
        "service-update",
        "compose-sync",
        "exec",
        "backup",
        "restore"
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "visitedFiles", "scannedConfigFiles", "scanLimitReached"],
      "properties": {
        "root": {"type": "string"},
        "visitedFiles": {"type": "integer", "minimum": 0},
        "scannedConfigFiles": {"type": "integer", "minimum": 0},
        "scanLimitReached": {"type": "boolean"}
      }
    },
    "touchesSensitiveData": {"type": "boolean"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "valuesReturned"],
        "properties": {
          "type": {"type": "string"},
          "path": {"type": "string"},
          "inspection": {"enum": ["name-only", "keys-only"]},
          "valuesReturned": {"const": false},
          "keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "sensitiveKeys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "state": {"enum": ["unknown", "none", "present"]},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "path", "line", "message"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "path": {"type": "string"},
          "line": {"type": "integer", "minimum": 0},
          "message": {"type": "string"},
          "key": {"type": "string"}
        }
      }
    },
    "sinks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "evidence"],
        "properties": {
          "status": {
            "enum": [
              "unknown",
              "plaintext",
              "masked",
              "metadata-only",
              "sanitized-only",
              "write-only",
              "not-applicable"
            ]
          },
          "evidence": {"type": "string"},
          "verifiedAt": {"type": "string"},
          "scope": {"type": "string"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sink", "status"],
        "properties": {
          "sink": {"type": "string"},
          "status": {"type": "string"},
          "method": {"type": "string"},
          "verifiedAt": {"type": "string"},
          "scope": {"type": "string"},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "decision": {
      "enum": ["allow", "allow-with-redaction", "require-out-of-band-entry", "blocked"]
    },
    "blockingReasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requiredActions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
